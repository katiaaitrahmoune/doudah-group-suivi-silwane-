PORT=3000

# Chaîne de connexion PostgreSQL (Neon). Récupérée depuis le tableau de bord
# Neon : Project > Connection Details > Connection string (choisir "Pooled
# connection" pour un usage en production). Doit inclure ?sslmode=require.
# Exemple :
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/suivi_silwane?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/suivi_silwane

# Code d'accès partagé pour l'espace "service informatique".
# À changer avant mise en production, puis à distribuer uniquement
# aux personnes autorisées à traiter les tickets.
IT_PASSCODE=doudah-si-2026

# Clé utilisée pour signer le cookie de session SI. À remplacer par une
# chaîne aléatoire longue en production (ex. openssl rand -hex 32).
SESSION_SECRET=change-this-secret

# Brevo (ex-Sendinblue) pour la notification par email lorsqu'un ticket passe
# à "Résolu". Facultatif : si BREVO_API_KEY n'est pas renseignée, l'email
# n'est pas envoyé (il est seulement journalisé dans la console).
#
# 1. Créer un compte sur https://www.brevo.com (gratuit jusqu'à 300 emails/jour).
# 2. Vérifier un expéditeur (Paramètres > Expéditeurs & IP > Ajouter un
#    expéditeur), par ex. support-silwane@doudah.com ou une adresse déjà
#    vérifiée via le domaine de l'entreprise.
# 3. Récupérer la clé API : Paramètres > Clés API (SMTP & API) > Générer une
#    nouvelle clé API.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=support-silwane@doudah.com
BREVO_SENDER_NAME=Suivi Silwane — SARL BPI/ENH DOUDAH
